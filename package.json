{
  "name": "margin",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "margin": "node packages/cli/bin/margin.js",
    "fixtures:build": "scripts/build-fixtures.sh",
    "golden:update": "GOLDEN_UPDATE=1 vitest run packages/cli/test/golden.test.ts",
    "fixtures:annotate": "scripts/build-fixture-annotations.sh",
    "validator:build": "tsx scripts/build-validator.ts"
  },
  "devDependencies": {
    "@margin/core": "workspace:*",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
